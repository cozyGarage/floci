<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal, high-signal ruleset for Floci.

  Scope is deliberately narrow: rules that flag real correctness/maintainability
  risks and that the codebase is already clean against, so the gate gives real
  signal from day one instead of failing the build on a backlog of pre-existing
  violations. Expand only with a deliberate decision.

  NeedBraces (AGENTS.md: "Always use braces in conditionals") is intentionally
  NOT enabled yet: a repo-wide check found ~1400 pre-existing single-statement
  `if` bodies without braces. Enabling it here would fail every build until a
  dedicated, reviewed cleanup pass fixes them — that cleanup is a separate,
  deliberate change, not something to fold into an unrelated task. Enable it
  once that backlog is cleared.
-->
<module name="Checker">
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- AGENTS.md: "Never leave a catch block empty" -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Dead code / correctness -->
        <module name="EqualsHashCode"/>
        <module name="UnusedImports"/>
    </module>
</module>
